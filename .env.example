# Copy to .env for local development. Never commit real credentials.
APP_ENV=local
APP_TIME_ZONE=Asia/Shanghai

DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=seafood_trace
DB_USERNAME=trace_user
DB_PASSWORD=change-me-for-local-development
DB_ROOT_PASSWORD=change-root-password-for-local-development

# V8 历史 trace_batch_no 回填摘要密钥 (pepper)。
# 用途: 历史批次的 trace_batch_no = SHA-256(pepper + 固定 domain 分隔串 + 历史主键 id)，
#       使历史追溯批次号无法被离线枚举反推出数据库自增 ID。
# 要求: 必填，且 UTF-8 编码后不少于 32 字节的高熵随机值，否则 V8 迁移会立即失败
#       （禁止回退到公开默认算法）。为避免"复制本文件即得到一个人人可知的密钥"，
#       此处刻意留空：空值、纯空白、示例占位值、强度不足的值都会被迁移回调拒绝。
#       同一套历史数据必须长期使用同一个值，更换后历史 trace_batch_no 不再可复现；
#       请按环境独立生成与保管，切勿提交真实值到 Git。
# 生成示例: openssl rand -base64 48
TRACE_BATCH_NO_HISTORY_PEPPER=

VITE_API_BASE_URL=http://localhost:8080/api
